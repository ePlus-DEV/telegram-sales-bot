# LOCAL DEVELOPMENT ONLY. Never commit .dev.vars.
# Multi-bot: see docs/MULTI_BOT.md. Use MULTI_BOTS and prefixed SHOP_A_*
# secrets, plus a distinct SHOP_A_DB Cloudflare D1 binding for each bot.
BOT_TOKEN=123456789:replace_with_botfather_token
TELEGRAM_WEBHOOK_SECRET=replace_with_random_alphanumeric_secret
SEPAY_WEBHOOK_API_KEY=replace_with_sepay_secret
ADMIN_TELEGRAM_ID=123456789
BANK_BIN=970422
BANK_ACCOUNT_NO=0000000000
BANK_ACCOUNT_NAME=YOUR NAME
SUPPORT_USERNAME=your_telegram_username

# Local admin dashboard only; never commit .dev.vars with the real password.
ADMIN_DASHBOARD_PASSWORD=replace-with-a-generated-32-character-secret
