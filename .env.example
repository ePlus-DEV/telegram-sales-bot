# Copy to .env locally (ignored by git). For Vercel/Railway/Render/Koyeb
# add these keys using each platform's secure Environment Variables UI.
BOT_TOKEN=
# MULTI-BOT OPTION: set MULTI_BOTS to a JSON array of {id,host}; use only
# prefixed credentials/databases, e.g. SHOP_A_BOT_TOKEN, SHOP_A_TELEGRAM_WEBHOOK_SECRET,
# SHOP_A_TURSO_DATABASE_URL and SHOP_A_TURSO_AUTH_TOKEN.
# Each bot needs its own HTTPS hostname and separate persistent database.
# MULTI_BOTS=[{"id":"shop_a","host":"shop-a.example.com"}]
# SHOP_A_BOT_TOKEN=
# SHOP_A_TELEGRAM_WEBHOOK_SECRET=
# SHOP_A_TURSO_DATABASE_URL=
# SHOP_A_TURSO_AUTH_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
SEPAY_WEBHOOK_API_KEY=
ADMIN_TELEGRAM_ID=
BANK_BIN=
BANK_ACCOUNT_NO=
BANK_ACCOUNT_NAME=
SUPPORT_USERNAME=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
PORT=3000
# Used only by the webhook registration script (run manually, not a hosting secret):
PUBLIC_BASE_URL=

# Required to enable /admin dashboard. Use a unique generated 32+ char secret.
ADMIN_DASHBOARD_PASSWORD=
