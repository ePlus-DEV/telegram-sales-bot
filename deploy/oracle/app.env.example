# Secrets: copy to app.env, chmod 600 and replace placeholders.
# Single-bot mode. Do NOT set MULTI_BOTS in this minimal deployment.
BOT_TOKEN=123456789:replace_with_botfather_token
TELEGRAM_WEBHOOK_SECRET=replace_with_a_random_alphanumeric_secret
ADMIN_TELEGRAM_ID=123456789
ADMIN_DASHBOARD_PASSWORD=replace_with_a_unique_32_character_password

# Persistent external database. Do not use ephemeral container SQLite for payments.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace_with_turso_token

# Physical goods only: enable all fields together if using SePay/VietQR.
# SEPAY_WEBHOOK_API_KEY=
# BANK_BIN=
# BANK_ACCOUNT_NO=
# BANK_ACCOUNT_NAME=
# SUPPORT_USERNAME=
