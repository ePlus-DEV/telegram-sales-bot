# Single TEST bot only. Do not insert live customer/payment credentials here.
# Copy this template to app.env on your InstaBox machine; chmod 600 app.env.
# This placeholder file is safe to commit, but NEVER commit app.env.
BOT_TOKEN=123456789:replace_with_test_botfather_token
TELEGRAM_WEBHOOK_SECRET=replace_with_unique_random_alphanumeric_secret
ADMIN_TELEGRAM_ID=123456789
ADMIN_DASHBOARD_PASSWORD=replace_with_random_password_32_characters

# Persistent remote test database; never store real orders in ephemeral sandbox files.
TURSO_DATABASE_URL=libsql://test-database.turso.io
TURSO_AUTH_TOKEN=replace_with_test_database_token

# Physical payments intentionally disabled in this sandbox template.
# For any controlled provider test, use separate test credentials and test DB.
# SEPAY_WEBHOOK_API_KEY=
# BANK_BIN=
# BANK_ACCOUNT_NO=
# BANK_ACCOUNT_NAME=
